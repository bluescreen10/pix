+	s.updateWarpBias(warpDepth{
+		n:     n,
+		far:   far,
+		xSpan: xSpan,
+		zSpan: zSpan,
+		tz:    tz,
+		world: l.ShadowBias,
+		coord: fit.eye.Length(),
+	})
+	return true
+}
