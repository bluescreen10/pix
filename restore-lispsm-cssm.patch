+	// Measure the warped bounds of everything that must fit: the body, plus the body
+	// pulled back to the casters' depth (same x and y, so only the z range grows). The
+	// points go back through world space because warp starts there — measuring the very
+	// matrix that will be used, rather than a reconstruction of it.
+	warp := warpMat.Mul4x4(lightMat)
+	xlo, xhi := float32(math.MaxFloat32), -float32(math.MaxFloat32)
+	zlo, zhi := xlo, xhi
+	for _, p := range body {
+		for _, z := range [2]float32{p[2], casterZ} {
+			w := fromLight(glm.Vec3f{p[0], p[1], z})
+			q := warp.Mul4x1(glm.Vec4f{w[0], w[1], w[2], 1})
+			if q[3] <= 0 {
+				return false // the body straddles the apex: no usable warp
+			}
+			xlo, xhi = min(xlo, q[0]/q[3]), max(xhi, q[0]/q[3])
+			zlo, zhi = min(zlo, q[2]/q[3]), max(zhi, q[2]/q[3])
+		}
+	}
+	xSpan, zSpan := xhi-xlo, zhi-zlo
+	if xSpan <= 0 || zSpan <= 0 {
+		return false
+	}
+
+	// N: x into [-1,1] and z into [1,0] — reversed-Z, since smaller light-space z is
+	// nearer the light and the depth test keeps the greater value.
+	sx, tx := 2/xSpan, -(xhi+xlo)/xSpan
+	sz, tz := -1/zSpan, zhi/zSpan
+	normalize := glm.Mat4f{
+		sx, 0, 0, 0, // column 0
+		0, 1, 0, 0, // column 1
+		0, 0, sz, 0, // column 2
+		tx, 0, tz, 1, // column 3
+	}
+
+	cam := s.warpCamera()
+	cam.viewProjection = normalize.Mul4x4(warp)
+	// A nominal eye for inspection (ShadowView.Camera.Position): where the warp
+	// projects from, in world space. Nothing in the pipeline reads it — a directional
+	// light has no real position — but a caller looking at the view deserves better
+	// than the origin.
+	cam.position = fromLight(glm.Vec3f{0.5 * (lo[0] + hi[0]), apexY, casterZ})
