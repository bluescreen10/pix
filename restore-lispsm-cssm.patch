+	far := at(d.center) + spread
+	span := 2 * spread
+
+	k := d.g / span
+	s.depthPlane = [4]float32{
+		-d.plane[0] * k,
+		-d.plane[1] * k,
+		-d.plane[2] * k,
+		(far - d.plane[3]*d.g) / span,
+	}
+
+	// Depth is linear in world distance along the ray, so a world-space bias converts by
+	// the span alone — no per-fragment term, unlike the warp (see updateWarpBias). The
+	// texel footprint is NOT folded in here: the shadow pass measures the real slope per
+	// fragment and offsets by it (scene_shadow_ray.frag), which is both tighter and
+	// correct for grazing receivers, so all that is left is the light's own bias over a
+	// small floor.
+	s.ndcBias = cssmMinBias + d.world/span
+
+}
