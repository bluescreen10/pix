diff --git b/shaders/src/scene_shadow_ray.frag.glsl a/shaders/src/scene_shadow_ray.frag.glsl
new file mode 100644
index 0000000..099ab47
--- /dev/null
+++ a/shaders/src/scene_shadow_ray.frag.glsl
@@ -0,0 +1,35 @@
+#version 460
+
+// CSSM's shadow-pass fragment stage: writes distance along the light ray as depth.
+//
+// CSSM flattens shadow casters onto a projection plane and rasterizes them from the
+// camera, so the rasterizer's own depth is the depth of the flattened point — the same
+// for an occluder and for whatever it shadows, which makes the comparison useless. The
+// value that does separate them is how far along the light ray the geometry sat before
+// being flattened, and that cannot be carried in gl_Position: it is the product of two
+// linear functions of position, so no 4x4 matrix produces it. The vertex stage computes
+// it with one dot product instead and it arrives here already normalized to [0,1],
+// increasing toward the light to match the reversed-Z depth test.
+//
+// Writing gl_FragDepth costs early-Z for this pass, which is why the other algorithms
+// keep using scene_shadow.frag and let fixed-function write depth.
+//
+// The slope term is not optional here. This map is rasterized from the CAMERA, so a
+// surface seen edge-on covers very few texels while spanning a lot of world, and its
+// ray distance changes steeply across each one — every receiver that recedes from the
+// viewer self-shadows without it. A constant bias cannot cover that: the steepness
+// varies per fragment over orders of magnitude within one frame. What it costs to
+// measure directly is two derivatives, because rendering from the camera is exactly
+// what makes the screen-space gradient of the stored value meaningful.
+//
+// |dFdx| + |dFdy| is the change in stored depth across one texel, so scaling it is
+// scaling in texels, and the offset lands on the far side of the surface from the light
+// (depth decreases away from the light) — the same thing polygon offset would do.
+layout(location = 0) in float vRayDepth;
+
+const float rayDepthSlopeTexels = 1.5;
+
+void main() {
+    float slope = abs(dFdx(vRayDepth)) + abs(dFdy(vRayDepth));
+    gl_FragDepth = vRayDepth - rayDepthSlopeTexels * slope;
+}
