+		dir := far.Sub(near)
+		if dir[1] == 0 {
+			return glm.Vec2f{}, false
+		}
+		hit := -near[1] / dir[1] // the ground is the plane y = 0
+		if hit < 0 || hit > 1 {
+			return glm.Vec2f{}, false
+		}
+		w := near.Add(dir.Scale(hit))
+		c := shadowVP.Mul4x1(glm.Vec4f{w[0], w[1], w[2], 1})
+		if c[3] <= 0 {
+			return glm.Vec2f{}, false
+		}
+		return glm.Vec2f{(c[0]/c[3]*0.5 + 0.5) * mapW, (c[1]/c[3]*0.5 + 0.5) * mapH}, true
+	}
+
+	// A row near the bottom of the screen: the closest ground the camera can see, and
+	// where a coarse map shows first.
+	const nearRow = size - 6
+	at, ok := texelAt(size/2, nearRow)
+	right, okR := texelAt(size/2+1, nearRow)
+	down, okD := texelAt(size/2, nearRow-1)
+	if !ok || !okR || !okD {
+		t.Fatal("the sampled screen pixels do not land on the ground; the test measures nothing")
+	}
+	across := math.Hypot(float64(right[0]-at[0]), float64(right[1]-at[1]))
+	along := math.Hypot(float64(down[0]-at[0]), float64(down[1]-at[1]))
+	if across < 1 || along < 1 {
+		t.Errorf("near the viewer one screen pixel gets %.2f texels across the map and %.2f "+
+			"down it; below one the edge staircases", across, along)
+	}
+	if ratio := max(across, along) / min(across, along); ratio > 2.5 {
+		t.Errorf("the map's axes are %.1fx out of balance (%.2f across, %.2f down); texels are "+
+			"being spent on the axis that already has enough", ratio, across, along)
+	}
+}
