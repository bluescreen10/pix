diff --git b/shadow_cssm.go a/shadow_cssm.go
new file mode 100644
index 0000000..f64f35e
--- /dev/null
+++ a/shadow_cssm.go
@@ -0,0 +1,203 @@
+// Camera space shadow maps (Kolic & Mihajlovic). The other two algorithms here place a
+// camera at the light and render the scene from it. CSSM does not: it flattens the
+// shadow casters onto a plane laid through the view frustum, along the light direction,
+// and renders that from the VIEW camera. Where a texel lands is then decided by the
+// camera's own projection, which is what makes near shadows dense — the map's sampling
+// follows the screen's by construction rather than by a warp chosen to approximate it.
+//
+// The paper's other half, pixel-accurate shadow map stretching, is not implemented: it
+// needs a geometry shader to expand each triangle into a quad and reject fragments per
+// pixel, and this RHI has vertex and fragment stages only (Metal has no geometry stage
+// at all). Without it the paper puts this in the same quality class as TSM.
+package pix
+
+import (
+	"github.com/bluescreen10/pix/glm"
+	"github.com/bluescreen10/pix/scenes"
+	"github.com/chewxy/math32"
+)
+
+// cssmMinLightSpread is how much of the light direction must lie across the view before
+// the single-plane fit is worth attempting. Below it the light runs nearly along the
+// view axis — the dueling frustum case, which one plane cannot cover (a single plane
+// leaves an unshadowed wedge; the paper uses four).
+const cssmMinLightSpread float32 = 0.05
+
+// cssmFocusScale trims the derived focus distance below the geometric mean of the
+// covered slice — see shadowFocusFor. The cost is asymmetric: focusing too near gives up
+// a little distant resolution, while focusing too far flattens the projection toward
+// orthographic and surrenders the whole benefit, so the derived value leans near.
+//
+// Chosen by sweeping two scenes an order of magnitude apart in size and keeping the
+// near field above one shadow texel per screen pixel in both, since below one is where
+// edges start to staircase. Raising it trades the large scene's near field for the small
+// one's mid-field, and 1.3 is already enough to put the large scene under one.
+const cssmFocusScale float32 = 0.8
+
+// fitCSSM builds the general (single-plane) CSSM camera for a directional light, and
+// reports whether it could. False means the configuration needs a fit this does not
+// implement, and the caller falls back.
+func (r *Renderer) fitCSSM(s *shadowResource, l scenes.LightPacket, fit shadowFit) bool {
+	lightDir := l.Direction.Normalize()
+	forward := fit.forward
+
+	// Roll the camera about its own view axis until the light arrives from "above" in
+	// the rolled image. The paper's whole construction assumes that orientation: the
+	// projection plane is then laid from the bottom of the near plane to the top of the
+	// far plane, and the light rays cross it front to back.
+	across := lightDir.Sub(forward.Scale(lightDir.Dot(forward)))
+	if across.Length() < cssmMinLightSpread {
+		return false
+	}
+	up := across.Normalize().Scale(-1) // light travels down the image, so up opposes it
+	right := forward.Cross(up).Normalize()
+	up = right.Cross(forward) // re-orthogonalize; LookAtRH derives its basis the same way
+
+	// Push the rolled camera back from the eye (paper §3.2). Left where it is, a
+	// perspective map spends its first half on the span [n, 2n> — with a near plane at
+	// 0.3 that is everything within 60cm of the viewer and nothing else, while the
+	// entire rest of the view shares what remains. Backing the camera off by `offset`
+	// moves the half-way point out to the focus distance instead: half the map covers
+	// [near, focus], half covers the rest. Solving 2·(near + offset) − offset = focus
+	// for the offset is the whole derivation.
+	//
+	// This is the same trade PSM, TSM and LiSPSM all make, and it costs the same thing:
+	// widening the near end of the frustum introduces wastage across the map's x axis
+	// (paper Fig. 3), which the paper removes with a stretching pass that needs a
+	// geometry shader. Without that, the focus push is still worth far more than it
+	// costs — see the sweep in the doc comment on Renderer.SetShadowFocus.
+	origin := fit.eye
+	if focus := r.shadowFocusFor(fit); focus > 0 {
+		origin = origin.Sub(forward.Scale(max(focus-2*fit.nearDist, 0)))
+	}
+
+	// The rolled camera has to contain the original frustum, so its bounds come from
+	// the frustum's own corners measured in the rolled basis. Tangents rather than
+	// extents: they do not depend on which plane they are measured at, which keeps the
+	// reversed-Z near/far swap below honest.
+	var lo, hi glm.Vec2f
+	near, far := float32(math32.MaxFloat32), float32(0)
+	for i, c := range fit.corners {
+		v := c.Sub(origin)
+		z := v.Dot(forward)
+		if z <= 0 {
+			return false // a corner behind the eye; not a frustum this fit can describe
+		}
+		t := glm.Vec2f{v.Dot(right) / z, v.Dot(up) / z}
+		if i == 0 {
+			lo, hi = t, t
+		}
+		for k := range 2 {
+			lo[k] = min(lo[k], t[k])
+			hi[k] = max(hi[k], t[k])
+		}
+		near, far = min(near, z), max(far, z)
+	}
+	if hi[0]-lo[0] <= 0 || hi[1]-lo[1] <= 0 || far <= near {
+		return false
+	}
+
+	// The projection plane runs from the BOTTOM of the near plane to the TOP of the far
+	// plane (Fig. 1). Laid that way it faces the light, which now comes from above, and
+	// it cuts through the whole frustum — so every visible receiver has a caster ray
+	// crossing it, and the plane's own extent in the image is the full view.
+	nearBottom := origin.Add(forward.Scale(near)).Add(up.Scale(lo[1] * near))
+	farTop := origin.Add(forward.Scale(far)).Add(up.Scale(hi[1] * far))
+
+	// Both edges run along the rolled right axis, so the plane contains it.
+	normal := right.Cross(farTop.Sub(nearBottom))
+	if normal.Length() < 1e-6 {
+		return false
+	}
+	normal = normal.Normalize()
+	planeD := -normal.Dot(nearBottom)
+
+	// Flattening along the light is only defined while the rays actually cross the
+	// plane. They do by construction, but a near-grazing angle blows the projection up.
+	denom := normal.Dot(lightDir)
+	if math32.Abs(denom) < 1e-4 {
+		return false
+	}
+	g := 1 / denom
+
+	// M: slide each point along the light until it lands on the plane,
+	// p' = p - lightDir·(normal·p + planeD)/(normal·lightDir). Linear in p, so it is a
+	// plain matrix, and its bottom row stays (0,0,0,1) because the light direction has
+	// no w — the flatten composes with the camera's projection into one matrix, and the
+	// depth pass needs no special vertex path for it.
+	plane := [4]float32{normal[0], normal[1], normal[2], planeD}
+	var flatten glm.Mat4f
+	for col := range 4 {
+		for row := range 4 {
+			v := float32(0)
+			if row == col {
+				v = 1
+			}
+			if row < 3 {
+				v -= g * lightDir[row] * plane[col]
+			}
+			flatten[col*4+row] = v
+		}
+	}
+
+	view := glm.LookAtRH(origin, origin.Add(forward), up)
+	proj := frustumTanRevZRH(lo[0], hi[0], lo[1], hi[1], near, far)
+
+	cam := s.warpCamera()
+	cam.viewProjection = proj.Mul4x4(view).Mul4x4(flatten)
+	cam.position = origin
+
+	s.updateRayDepth(rayDepth{
+		plane:  plane,
+		g:      g,
+		center: fit.sceneCenter,
+		radius: fit.sceneRadius,
+		// Texels are coarsest at the far end of the plane, and the two axes are sized
+		// independently (cssmMapShape), so each is measured against its own resolution
+		// and acne has to clear whichever is worse.
+		texel: far * max((hi[0]-lo[0])/float32(max(s.width, 1)), (hi[1]-lo[1])/float32(max(s.height, 1))),
+		world: l.ShadowBias,
+	})
+	return s.depthPlane != [4]float32{}
+}
+
+// frustumTanRevZRH is an off-centre right-handed perspective projection given the
+// tangents of its four half-angles, with the engine's reversed depth range (near → 1,
+// far → 0; see glm.PerspectiveRevZRH).
+//
+// Tangents rather than plane extents because CSSM measures its bounds by projecting
+// frustum corners, which yields angles directly; and because the reversed range is
+// produced by swapping near and far, which would invalidate extents measured at one of
+// them but leaves angles untouched.
+func frustumTanRevZRH(left, right, bottom, top, near, far float32) glm.Mat4f {
+	n, f := far, near // reversed-Z
+	x := 2 / (right - left)
+	y := 2 / (top - bottom)
+	a := (right + left) / (right - left)
+	b := (top + bottom) / (top - bottom)
+	c := f / (n - f)
+	return glm.Mat4f{
+		x, 0, 0, 0, // column 0
+		0, y, 0, 0, // column 1
+		a, b, c, -1, // column 2
+		0, 0, n * f / (n - f), 0, // column 3
+	}
+}
+
+// shadowFocusFor is the distance CSSM reserves half its shadow map for, in world units
+// from the eye. Renderer.SetShadowFocus overrides it.
+//
+// The derived value is the GEOMETRIC mean of the slice being covered, not a fraction of
+// it. A fraction tracks the far distance linearly, which is wrong in exactly the case
+// that matters: double the view distance and the region you actually care about does not
+// move twice as far away, but a fractional focus does — in a scene a few hundred units
+// deep it lands out in the mid-field and leaves everything near the viewer resolving
+// worse than the horizon. The geometric mean grows as the square root instead, which
+// keeps the focus in the near field across scene scales that differ by more than an
+// order of magnitude.
+func (r *Renderer) shadowFocusFor(fit shadowFit) float32 {
+	if r.shadowFocus > 0 {
+		return r.shadowFocus
+	}
+	return cssmFocusScale * math32.Sqrt(max(fit.nearDist, 1e-4)*max(fit.farDist, 1e-4))
+}
