+// points on one ray share x, y (and so w), and their depths differ only through z.
+func (r *Renderer) fitLiSPSM(s *shadowResource, l scenes.LightPacket, fit shadowFit) bool {
+	dz := l.Direction.Normalize()
+
+	// The warp axis: the view direction with the light direction projected out. Its
+	// length is sin(gamma), the angle between the two.
