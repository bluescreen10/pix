+// batchSpan is a contiguous run of batches issued as one indirect draw.
+type batchSpan struct {
+	first, count uint32
+}
+
+// updateWorldBounds refreshes every drawable's bounding sphere in world space.
+//
+// Drawable bounds are local, so this applies deliberately the same transform
+// scene_cull.comp does: the CPU's decision about which draws to issue and the GPU's
+// decision about which instances survive have to agree, and the cheapest way to
+// guarantee that is to compute visibility from the same numbers.
+//
+// It runs every frame rather than with the batch layout, because a scene whose objects
+// move keeps its layout and invalidates only its bounds.
+func (d *drawList) updateWorldBounds(p *scenes.FramePacket) {
+	if cap(d.worldBounds) < len(d.drawables) {
+		d.worldBounds = make([]glm.Vec4f, len(d.drawables))
+	}
+	d.worldBounds = d.worldBounds[:len(d.drawables)]
+	for i := range d.drawables {
+		dr := &d.drawables[i]
+		m := transformAt(p, dr.transformID)
+		c := m.Mul4x1(glm.Vec4f{dr.bounds[0], dr.bounds[1], dr.bounds[2], 1})
+		// The largest axis scale, not the average: a non-uniform scale must never
+		// shrink the sphere below the geometry it bounds.
+		sx := glm.Vec3f{m[0], m[1], m[2]}.Length()
+		sy := glm.Vec3f{m[4], m[5], m[6]}.Length()
+		sz := glm.Vec3f{m[8], m[9], m[10]}.Length()
+		d.worldBounds[i] = glm.Vec4f{c[0], c[1], c[2], dr.bounds[3] * max(sx, max(sy, sz))}
+	}
+}
+
+// liveBatches marks which batches can still draw something in the view described by
+// planes, and reports whether any can. castersOnly restricts it to shadow casters, as
+// the cull shader's own castersOnly does.
+//
+// This decides which indirect draws are worth issuing at all. It is NOT a replacement
+// for the GPU cull, which still rejects instance by instance — the point is that a
+// draw for a batch the cull will empty is not free. Metal has no multi-draw-indirect,
+// so every batch is a separate API draw whether or not its instanceCount is zero, and
+// at roughly a microsecond each a scene's worth of empty draws per cascade is the
+// single largest cost in the shadow pass.
+//
+// Conservative is the contract: a batch is live if ANY of its drawables might be
+// visible. It may keep a batch the GPU then empties, but it must never drop one the
+// GPU would have drawn. That is why LOD is ignored here — the level is chosen on the
+// GPU, so every level's drawable has to count.
+func (d *drawList) liveBatches(planes [6]glm.Vec4f, castersOnly bool) bool {
+	if cap(d.batchLive) < len(d.batches) {
+		d.batchLive = make([]bool, len(d.batches))
+	}
+	d.batchLive = d.batchLive[:len(d.batches)]
+	clear(d.batchLive)
+	any := false
+	for i := range d.drawables {
+		dr := &d.drawables[i]
+		if castersOnly && dr.flags&DrawableCastsShadow == 0 {
+			continue
+		}
+		if d.batchLive[dr.batchID] || sphereOutside(planes, d.worldBounds[i]) {
+			continue
+		}
+		d.batchLive[dr.batchID] = true
+		any = true
+	}
+	return any
+}
+
+// liveSpans appends the contiguous runs of live batches within [first, first+count) to
+// out, as marked by the most recent liveBatches.
+//
+// Spans rather than individual batches because a run of neighbours still costs one
+// draw between them all. A view that keeps a scattered subset pays more draws than a
+// view that keeps a compact one, but never more than the count it replaces.
+func (d *drawList) liveSpans(first, count uint32, out []batchSpan) []batchSpan {
+	for i := first; i < first+count; {
+		if !d.batchLive[i] {
+			i++
+			continue
+		}
+		start := i
+		for i < first+count && d.batchLive[i] {
+			i++
+		}
+		out = append(out, batchSpan{first: start, count: i - start})
+	}
+	return out
+}
+
+// sphereOutside reports whether a world-space bounding sphere (xyz centre, w radius)
+// lies wholly beyond one of the frustum planes — the same test scene_cull.comp makes.
+func sphereOutside(planes [6]glm.Vec4f, s glm.Vec4f) bool {
+	for _, p := range planes {
+		if p[0]*s[0]+p[1]*s[1]+p[2]*s[2]+p[3] < -s[3] {
+			return true
+		}
+	}
+	return false
+}
