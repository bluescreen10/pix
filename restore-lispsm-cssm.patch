new file mode 100644
index 0000000..9b01755
--- /dev/null
+++ a/shadow_cssm_test.go
@@ -0,0 +1,382 @@
+package pix_test
+
+import (
+	"math"
+	"testing"
+
+	"github.com/bluescreen10/pix"
+	"github.com/bluescreen10/pix/cameras"
+	"github.com/bluescreen10/pix/colors"
+	"github.com/bluescreen10/pix/glm"
+	"github.com/bluescreen10/pix/scenes"
+)
+
+// walkway is the case every perspective shadow algorithm exists for: a corridor of
+// pillars receding from a viewer standing on the ground, where a shadow edge a metre
+// away and one fifty metres away need wildly different amounts of the same map. Returns
+// the scene and its camera; the caller owns both (see occluderScene).
+func walkway(t *testing.T, r *pix.Renderer, mapSize uint32) (*scenes.Scene, pix.Camera) {
+	scene, cam, _ := walkwayLit(t, r, mapSize)
+	return scene, cam
+}
+
+// walkwayLit is walkway plus the id of its light, for tests that ask the renderer for
+// the shadow camera it fitted.
+func walkwayLit(t *testing.T, r *pix.Renderer, mapSize uint32) (*scenes.Scene, pix.Camera, scenes.LightID) {
+	t.Helper()
+	scene := scenes.New()
+	scene.SetAmbient(colors.RGB32F{0.05, 0.05, 0.05})
+	light := scene.AddDirectionalLight(glm.Vec3f{0.45, -1, 0.3}, colors.RGB32F{1, 1, 1}, 3)
+	light.SetCastShadow(true)
+	if mapSize != 0 {
+		light.Shadow().SetSize(mapSize)
+	}
+
+	cube := r.GeometryStore.Create(pix.BoxGeometry(1, 1, 1))
+	defer cube.Release()
+
+	ground := scene.NewMesh(cube, r.NewPBRMaterial())
+	ground.SetScale(glm.Vec3f{120, 0.2, 120})
+	scene.Add(ground)
+	for i := range 18 {
+		z := 2 - float32(i)*3
+		for _, x := range []float32{-2.2, 2.2} {
+			p := scene.NewMesh(cube, r.NewPBRMaterial())
+			p.SetPosition(glm.Vec3f{x, 1.3, z})
+			p.SetScale(glm.Vec3f{0.5, 2.6, 0.5})
+			p.SetCastShadow(true)
+			scene.Add(p)
+		}
+	}
+
+	cam := cameras.NewPerspectiveCamera(60, 1, 0.3, 200)
+	cam.SetPosition(glm.Vec3f{0, 1.7, 7})
+	cam.SetTarget(glm.Vec3f{0, 1.2, -10})
+	return scene, cam, light.ID()
+}
+
+// shadowMask renders the walkway twice and reports which pixels the shadow darkened.
+func shadowMask(t *testing.T, algo pix.ShadowAlgorithm, size int, mapSize uint32) []bool {
+	t.Helper()
+	r, err := pix.NewOffscreenRenderer(uint32(size), uint32(size))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Destroy()
+	r.SetClearColor(colors.RGBA32F{0, 0, 0, 1})
+	r.SetShadow(algo)
+
+	scene, cam := walkway(t, r, mapSize)
+	defer scene.Destroy()
+
+	r.EnableShadows(false)
+	r.Render(scene, cam)
+	lit := append([]byte(nil), r.Pixels()...)
+	r.EnableShadows(true)
+	r.Render(scene, cam)
+	shadowed := r.Pixels()
+
+	out := make([]bool, size*size)
+	for i := range out {
+		out[i] = int(lit[i*4])-int(shadowed[i*4]) > 12
+	}
+	return out
+}
+
+// TestCSSMSharpensNearShadows is the reason CSSM is here. Its map is rasterized from
+// the camera, so where its texels land follows the screen by construction rather than
+// by a warp chosen to approximate it — which should show up as shadow edges nearer the
+// viewer landing where a very high resolution map says they belong.
+//
+// Ground truth is a uniform fit given so many texels that its edges are exact; each
+// algorithm then gets a small map and is scored on how many near-half pixels it gets
+// wrong. Scoring against truth rather than against each other is what makes this a
+// measurement of accuracy and not merely of difference.
+func TestCSSMSharpensNearShadows(t *testing.T) {
+	const size = 256
+	truth := shadowMask(t, pix.ShadowUniform, size, 8192)
+
+	wrongNear := func(algo pix.ShadowAlgorithm, mapSize uint32) int {
+		got := shadowMask(t, algo, size, mapSize)
+		n := 0
+		for y := size / 2; y < size; y++ { // the near half: the bottom of the screen
+			for x := range size {
+				if got[y*size+x] != truth[y*size+x] {
+					n++
+				}
+			}
+		}
+		return n
+	}
+
+	const mapSize = 512
+	uniform := wrongNear(pix.ShadowUniform, mapSize)
+	cssm := wrongNear(pix.ShadowCSSM, mapSize)
+	if uniform == 0 {
+		t.Fatal("the uniform fit was already exact at this resolution; the test measures nothing")
+	}
+	if cssm >= uniform/2 {
+		t.Errorf("CSSM got %d near pixels wrong against a uniform fit's %d; it is supposed to "+
+			"spend far more of the map near the viewer", cssm, uniform)
+	}
+}
+
+// TestCSSMPutsTheShadowWhereItBelongs: the algorithms differ in where they spend
+// resolution, never in where the shadow IS. Coverage is scored against a very high
+// resolution reference rather than against another small map — a uniform map small
+// enough to disagree with CSSM is also small enough to be the one that is wrong, so
+// comparing two small maps measures nothing.
+//
+// The floor is 80% rather than something near 100% because a shadow edge is biased away
+// from its caster by roughly a texel, and on the thin pillar shadows here that is a
+// large share of the area. It is not CSSM's doing: ShadowLiSPSM sits at the same number,
+// and both stay there however large the map gets, which is what identifies it as a bias
+// offset rather than a sampling error. What the second assertion pins is the part that
+// IS CSSM's doing — at a resolution low enough to hurt, it should not lose shadow the
+// way a uniform fit does.
+func TestCSSMPutsTheShadowWhereItBelongs(t *testing.T) {
+	const size = 256
+	truth := shadowMask(t, pix.ShadowUniform, size, 8192)
+
+	cover := func(algo pix.ShadowAlgorithm, mapSize uint32) float64 {
+		got := shadowMask(t, algo, size, mapSize)
+		var both, total int
+		for i := range truth {
+			if truth[i] {
+				total++
+				if got[i] {
+					both++
+				}
+			}
+		}
+		if total == 0 {
+			t.Fatal("the reference shadowed nothing; the test measures nothing")
+		}
+		return 100 * float64(both) / float64(total)
+	}
+
+	if got := cover(pix.ShadowCSSM, 2048); got < 80 {
+		t.Errorf("CSSM covers only %.1f%% of the shadow a high-resolution map finds", got)
+	}
+	cssm, uniform := cover(pix.ShadowCSSM, 512), cover(pix.ShadowUniform, 512)
+	if cssm <= uniform {
+		t.Errorf("at 512 texels CSSM covers %.1f%% against a uniform fit's %.1f%%; the point "+
+			"of rasterizing from the camera is to hold up when the map is small", cssm, uniform)
+	}
+}
+
+// TestCSSMFallsBackWhenLightRunsAlongTheView pins the dueling frustum guard. One
+// projection plane cannot cover a light coming straight at or away from the viewer —
+// the paper uses four — so fitCSSM declines and the renderer uses the uniform fit.
+//
+// The assertion is that the two images are identical, not that some shadow appears: a
+// light along the view axis is exactly the configuration where every caster hides its
+// own shadow behind itself, so there is little to see no matter which fit runs. Pixel
+// identity with the uniform fit is what actually proves the fallback was taken.
+func TestCSSMFallsBackWhenLightRunsAlongTheView(t *testing.T) {
+	render := func(algo pix.ShadowAlgorithm) []byte {
+		r, err := pix.NewOffscreenRenderer(128, 128)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer r.Destroy()
+		r.SetClearColor(colors.RGBA32F{0, 0, 0, 1})
+		r.SetShadow(algo)
+		r.EnableShadows(true)
+
+		scene := scenes.New()
+		defer scene.Destroy()
+		scene.SetAmbient(colors.RGB32F{0.05, 0.05, 0.05})
+		light := scene.AddDirectionalLight(glm.Vec3f{0, -1, 0}, colors.RGB32F{1, 1, 1}, 3)
+		light.SetCastShadow(true)
+
+		cube := r.GeometryStore.Create(pix.BoxGeometry(1, 1, 1))
+		defer cube.Release()
+		ground := scene.NewMesh(cube, r.NewPBRMaterial())
+		ground.SetScale(glm.Vec3f{20, 0.2, 20})
+		scene.Add(ground)
+		occluder := scene.NewMesh(cube, r.NewPBRMaterial())
+		occluder.SetPosition(glm.Vec3f{0, 3, 0})
+		occluder.SetScale(glm.Vec3f{2, 0.4, 2})
+		occluder.SetCastShadow(true)
+		scene.Add(occluder)
+
+		// Straight down, so the light direction runs along the view axis.
+		cam := cameras.NewPerspectiveCamera(60, 1, 0.3, 100)
+		cam.SetPosition(glm.Vec3f{0, 14, 0.01})
+		cam.SetTarget(glm.Vec3f{0, 0, 0})
+		r.Render(scene, cam)
+		return append([]byte(nil), r.Pixels()...)
+	}
+
+	uniform, cssm := render(pix.ShadowUniform), render(pix.ShadowCSSM)
+	lit := 0
+	for i := 0; i < len(uniform); i += 4 {
+		if uniform[i] > 12 {
+			lit++
+		}
+		for k := range 3 {
+			if v := cssm[i+k]; math.IsNaN(float64(v)) {
+				t.Fatalf("pixel %d channel %d is NaN", i/4, k)
+			}
+		}
+	}
+	if lit == 0 {
+		t.Fatal("the scene rendered black; the comparison would be vacuous")
+	}
+	for i := range uniform {
+		if uniform[i] != cssm[i] {
+			t.Fatalf("byte %d differs (uniform %d, cssm %d): the fit did not fall back",
+				i, uniform[i], cssm[i])
+		}
+	}
+}
+
+// TestShadowFocusRoundTrips: the focus distance is an application constant the paper
+// scales by genre (metres for a shooter, hundreds for a flight sim), so it has to be
+// settable and readable, and zero has to mean "derive it".
+func TestShadowFocusRoundTrips(t *testing.T) {
+	r, err := pix.NewOffscreenRenderer(32, 32)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Destroy()
+
+	if got := r.ShadowFocus(); got != 0 {
+		t.Errorf("a new renderer reports focus %v; want 0, meaning derived", got)
+	}
+	r.SetShadowFocus(25)
+	if got := r.ShadowFocus(); got != 25 {
+		t.Errorf("SetShadowFocus(25) then ShadowFocus() = %v", got)
+	}
+	r.SetShadowFocus(0)
+	if got := r.ShadowFocus(); got != 0 {
+		t.Errorf("focus did not return to derived: %v", got)
+	}
+}
+
+// TestCSSMWorksFarFromTheWorldOrigin: CSSM measures everything from the eye and the
+// view frustum, so nothing about it should depend on where in the world that is — the
+// same trap LiSPSM fell into (see TestLiSPSMWorksFarFromTheWorldOrigin).
+func TestCSSMWorksFarFromTheWorldOrigin(t *testing.T) {
+	area := func(origin glm.Vec3f) int {
+		r, err := pix.NewOffscreenRenderer(160, 160)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer r.Destroy()
+		r.SetClearColor(colors.RGBA32F{0, 0, 0, 1})
+		r.SetShadow(pix.ShadowCSSM)
+
+		scene, cam, _ := occluderScene(t, r, origin)
+		defer scene.Destroy()
+
+		r.EnableShadows(false)
+		r.Render(scene, cam)
+		lit := append([]byte(nil), r.Pixels()...)
+		r.EnableShadows(true)
+		r.Render(scene, cam)
+		shadowed := r.Pixels()
+
+		n := 0
+		for i := 0; i < len(lit); i += 4 {
+			if int(lit[i])-int(shadowed[i]) > 12 {
+				n++
+			}
+		}
+		return n
+	}
+
+	base := area(glm.Vec3f{})
+	if base == 0 {
+		t.Fatal("no shadow at the world origin; the test measures nothing")
+	}
+	for _, d := range []float32{500, 5000, 50000} {
+		if got := area(glm.Vec3f{d, 0, d}); got < base/2 || got > base*2 {
+			t.Errorf("at offset %.0f the shadow covers %d px, vs %d at the origin", d, got, base)
+		}
+	}
+}
+
+// TestCSSMMapIsBalancedAcrossItsAxes pins the reshape. A CSSM map's two axes are not
+// interchangeable: across it, texels are spread over the full width of the frustum as
+// seen from a camera pushed back behind the eye, so near geometry gets few of them;
+// down it, the focus region concentrates them on exactly that geometry. Square, the
+// across axis lands below one texel per screen pixel while down sits near three — and
+// an axis below one is a staircased edge that crawls as the camera moves.
+//
+// The measurement walks a ray through a screen pixel onto the ground, then asks how far
+// its neighbour lands away in the map. Both axes have to clear one texel per pixel near
+// the viewer, which is what the long narrow allocation buys.
+func TestCSSMMapIsBalancedAcrossItsAxes(t *testing.T) {
+	const size = 256
+	const requested = 1024
+
+	r, err := pix.NewOffscreenRenderer(size, size)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer r.Destroy()
+	r.SetClearColor(colors.RGBA32F{0, 0, 0, 1})
+	r.SetShadow(pix.ShadowCSSM)
+	r.EnableShadows(true)
+
+	scene, cam, lightID := walkwayLit(t, r, requested)
+	defer scene.Destroy()
+	r.Render(scene, cam)
+
+	view := r.ShadowView(scene.ID(), lightID)
+	if view == nil {
+		t.Fatal("the renderer fitted no shadow camera")
+	}
+	shadowVP := view.Camera.ViewProjection()
+	inv := cam.ViewProjection().Inv()
+
+	// The map's shape is the renderer's business, not this test's — but the density it
+	// produces is the point, so the expected shape is stated rather than queried.
+	mapW, mapH := float32(requested*2), float32(requested/2)
+
+	// texelAt casts a ray through a screen pixel to the ground and reports where it
+	// lands in the map, in texels.
+	texelAt := func(sx, sy float32) (glm.Vec2f, bool) {
+		ndc := glm.Vec4f{2*sx/size - 1, 1 - 2*sy/size, 1, 1}
+		a := inv.Mul4x1(ndc)
+		b := inv.Mul4x1(glm.Vec4f{ndc[0], ndc[1], 0, 1})
+		near := glm.Vec3f{a[0] / a[3], a[1] / a[3], a[2] / a[3]}
