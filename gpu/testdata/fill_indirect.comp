#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// The GPU-driven culler pattern: a compute pass writes a DrawIndexedIndirect
// command (incmd. an atomicAdd on instanceCount) that a later indirect draw reads.
struct DrawIndexedIndirect {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int  vertexOffset;
    uint firstInstance;
};

layout(buffer_reference, scalar) buffer IndirectBuf {
    DrawIndexedIndirect cmd;
};

layout(buffer_reference, scalar) readonly buffer CompRoot {
    IndirectBuf indirect;
};

layout(push_constant) uniform CPush { CompRoot root; } cpc;

layout(local_size_x = 1) in;
void main() {
    cpc.root.indirect.cmd.indexCount    = 3u;
    cpc.root.indirect.cmd.firstIndex    = 0u;
    cpc.root.indirect.cmd.vertexOffset  = 0;
    cpc.root.indirect.cmd.firstInstance = 0u;
    atomicAdd(cpc.root.indirect.cmd.instanceCount, 1u);
}
